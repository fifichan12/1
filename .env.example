# GEMINI_API_KEY: Required for Gemini AI API calls (Chatbot tactique QG).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EMAIL / SMTP TRANSACTIONNEL POUR FOST AIRSOFT (Notification des dossiers d'adhésion)
# Adresse de réception du bureau FOST : fost.contact.off@gmail.com
EMAIL_DESTINATION="fost.contact.off@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="fost.contact.off@gmail.com"
SMTP_PASS="votre_mot_de_passe_application_google_16_caracteres"

# PAIEMENT EN LIGNE (HELLOASSO API V5)
HELLOASSO_CLIENT_ID="votre_client_id_helloasso"
HELLOASSO_CLIENT_SECRET="votre_client_secret_helloasso"
HELLOASSO_ORG_SLUG="votre_slug_organisation_helloasso"
HELLOASSO_ENV="sandbox" # "sandbox" pour test ou "production"
APP_BASE_URL="http://localhost:3000"

# AUTHENTIFICATION & SÉCURITÉ
# Par défaut, les comptes test rapides 1-clic sont affichés UNIQUEMENT en mode développement local (DEV).
# En production, mettez à "true" pour forcer l'affichage, ou laissez absent/false pour les masquer totalement.
VITE_SHOW_TEST_ACCOUNTS="false"
