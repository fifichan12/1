{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil d'un opérateur ou adhérent FOST Airsoft",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Identifiant Firebase Auth" },
        "callsign": { "type": "string", "description": "Indicatif radio terrain" },
        "displayName": { "type": "string", "description": "Nom complet" },
        "email": { "type": "string", "description": "Email de contact" },
        "phone": { "type": "string", "description": "Numéro de téléphone" },
        "role": { "type": "string", "enum": ["COMMANDANT", "OPERATEUR", "RECRUE", "INVITE"] },
        "memberTier": { "type": "string", "enum": ["TEST", "TITULAIRE", "PREMIUM", "NON_MEMBRE"] },
        "isStaff": { "type": "boolean", "description": "Droits d'administration QG" },
        "photoURL": { "type": "string", "description": "URL avatar opérateur" },
        "createdAt": { "type": "string", "description": "Date de création du compte" }
      },
      "required": ["uid", "email"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Réservation de créneau d'opération tactique",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "description": "Identifiant de la réservation" },
        "userId": { "type": "string", "description": "ID du joueur réservataire" },
        "userEmail": { "type": "string", "description": "Email du joueur" },
        "callsign": { "type": "string", "description": "Callsign utilisé" },
        "opId": { "type": "string", "description": "ID de l'opération réservée" },
        "opTitle": { "type": "string", "description": "Titre de l'opération" },
        "isMember": { "type": "boolean", "description": "Statut adhérent (0€)" },
        "totalPrice": { "type": "number", "description": "Total PAF en euros" },
        "status": { "type": "string", "description": "CONFIRME ou EN_ATTENTE" },
        "createdAt": { "type": "string", "description": "Horodatage de réservation" }
      },
      "required": ["bookingId", "userId", "opId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Collection des profils utilisateurs authentifiés"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Collection des réservations de parties"
    }
  }
}
